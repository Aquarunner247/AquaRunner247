// AquaRunner 24/7 Pro — PostgreSQL (Supabase-ready)
// Service days: 1–7 weekdays per body of water (ISO 8601: 1=Mon … 7=Sun), validated in app: 1–7 rows, unique.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OFFICE
  TECHNICIAN
}

enum BodyOfWaterType {
  POOL
  SPA
  WADING_POOL
  FOUNTAIN
  WATER_FEATURE
  OTHER
}

enum EquipmentKind {
  PUMP
  FILTER
  HEATER
  CHLORINATOR
  AUTOMATION
  FLOW_METER
  MAIN_DRAIN_COVER
  SKIMMER_COVER
  VALVE
  OTHER
}

enum FilterMedia {
  SAND
  CARTRIDGE
  DE
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
}

/// For pools with a spa: whether a pump/main drain serves the filtration loop or the jets
enum EquipmentPurpose {
  FILTRATION
  JETS
}

enum ScheduleFrequency {
  WEEKLY
  BIWEEKLY
  CUSTOM
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
}

enum OrganizationPlanStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  COMPED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Business identity shown to this org's own customers/inspectors (public QR log, CSV export).
  businessName  String?
  businessPhone String?

  planStatus           OrganizationPlanStatus @default(TRIALING)
  trialEndsAt          DateTime?
  stripeCustomerId     String?                @unique
  stripeSubscriptionId String?                @unique
  currentPeriodEnd     DateTime?

  /// Captured at signup — USPS 2-letter code ("NV", "CA", ...). Null for accounts that
  /// predate multi-state support and haven't been backfilled yet.
  state               String?
  /// Captured at signup — whether this account services any commercial pools at all.
  /// Null means "not asked yet" (pre-multi-state accounts); false means residential-only,
  /// so compliance features never apply regardless of state support.
  hasCommercialPools  Boolean?
  complianceRulesetId String?
  complianceRuleset   ComplianceRuleset? @relation(fields: [complianceRulesetId], references: [id])

  /// Opt-in, paid add-on -- gates whether the Twilio voice webhook does anything beyond
  /// a generic "not available" TwiML response for this org's assigned number. Defaults
  /// false for every org; flipped per-org by a human once they're a paying customer for
  /// this feature. See OrgPhoneAgentSettings for the actual per-org configuration.
  aiPhoneAgentEnabled Boolean @default(false)

  users                 User[]
  customers             Customer[]
  properties            Property[]
  managementCompanies   ManagementCompany[]
  chemicalProducts      ChemicalProduct[]
  checklistItems        ChecklistItemDefinition[]
  recurringRoutes       RecurringRoute[]
  serviceVisits         ServiceVisit[]
  adHocStops            AdHocStop[]
  technicianPayRates    TechnicianPayRate[]
  payrollSettings       OrgPayrollSettings?
  dosingProductSettings OrgChemicalProductSetting[]
  complianceTargets     OrgComplianceTarget[]
  phoneAgentSettings    OrgPhoneAgentSettings?
  phoneAgentCalls       PhoneAgentCall[]
  phoneAgentDailyUsage  PhoneAgentDailyUsage[]

  @@index([complianceRulesetId])
}

/// Config-driven, per-state compliance rules -- replaces hardcoded Nevada/SNHD logic.
/// Nevada ("NV") is the only fully populated, isSupported:true record initially; every
/// other state exists as a stub (isSupported:false, name-only) so the data model is ready
/// to populate as more states' sheets/rules are gathered. County-level granularity
/// (SNHD is a Clark County entity, not a Nevada state agency) is deliberately deferred --
/// per-state chemistry/frequency/event data lives in the four child models below --
/// see COMPLIANCE_RULESET_NOTES.md for the full design rationale (real 9-state
/// regulatory data revealed rule shapes -- curves, cross-method dependencies, event
/// protocols, repeated-failure closures -- that a flat per-state row can't represent).
model ComplianceRuleset {
  id                   String  @id @default(cuid())
  /// USPS 2-letter code, e.g. "NV". "DC" included alongside the 50 states.
  state                String  @unique
  stateName            String
  healthDepartmentName String?
  /// False until this state's actual rules/sheets have been built out -- gates whether
  /// compliance features (QR inspector logs, closure-risk banners, rule engine) show at
  /// all for accounts linked to this ruleset.
  isSupported          Boolean @default(false)
  /// True only for a confirmed regulatory vacuum -- a state with NO state-level pool code
  /// to build against at all (Idaho: repealed 2025; Mississippi: no statewide code,
  /// regulation is set per health district), never inferred from isSupported or whether
  /// chemistryThresholds is empty. Idaho/Mississippi still carry real ChemistryThreshold
  /// rows (CDC Model Aquatic Health Code reference values, sourced from cmahc.org) shown
  /// to technicians as optional logging fields via activeReadingFields() -- this flag is
  /// what lets the compliance reference page distinguish "no law exists" from "just not
  /// built yet" (e.g. Florida while it was isSupported: false with full confirmed data)
  /// without depending on data presence, which stops being a reliable signal the moment a
  /// legally-unsupported state gets real advisory data seeded onto it.
  hasNoLegalRequirement Boolean @default(false)

  /// STATE: genuinely state-level (Alaska, Arkansas, Colorado, Florida).
  /// COUNTY: source regulation is a county health department's own code (Nevada/SNHD =
  /// Clark County, Alabama = Baldwin County, Arizona = Maricopa County).
  /// COUNTY_DISTRIBUTED_STATE_DERIVED: the regulation itself is state-level but the log
  /// sheet form is county-branded (California/Sacramento County) -- kept as its own
  /// value rather than silently picked as STATE or COUNTY; see the matching
  /// ComplianceNote on that record.
  jurisdictionLevel String?
  countyName        String?

  /// e.g. "5 CCR 1003-5", "18 AAC 30", "CT Public Health Code § 19-13-B33b"
  officialCitation      String?
  /// The actual source document(s) extracted from, e.g. "Guidelines for Arkansas Pools,
  /// Spas, and Other Aquatic Facility Operators -- Updated Edition, 2026"
  sourceDocument        String?
  /// How long operating logs must be retained on file, in months (12 for AL/AZ, 24 for
  /// CA, null where the source doesn't state one).
  recordRetentionMonths Int?

  logSheetSource      LogSheetSource?
  logSheetSourceLabel String?
  logSheetSourceNotes String?

  codeReferenceLabel String?
  codeReferenceUrl   String?
  /// Markdown body rendered on the in-app state code reference page. Only populated for
  /// Nevada so far -- extending the reference page to the other states is a separate pass.
  referenceContent   String? @db.Text

  chemistryThresholds ChemistryThreshold[]
  frequencyRules      FrequencyRule[]
  eventProtocols      EventProtocol[]
  complianceNotes     ComplianceNote[]

  organizations Organization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isSupported])
}

enum LogSheetSource {
  /// An actual official fill-in form exists; the app replicates it.
  STATE_PROVIDED
  /// No official form exists; log sheet fields were derived from the regulation text.
  BUILT_FROM_CODE
}

enum DisinfectionMethod {
  CHLORINE
  BROMINE
  HYDROGEN_PEROXIDE
  COPPER_ION
  SILVER_ION
  OZONE
  /// For method-agnostic parameters: pH, alkalinity, hardness, temperature, CYA, etc.
  NOT_APPLICABLE
}

/// One row per parameter x context (body-of-water type, disinfection method, indoor/
/// outdoor, or a conditional like "if CYA used") -- see COMPLIANCE_RULESET_NOTES.md.
/// `parameter` and `bodyOfWaterCategory` are deliberately free-text, not enums: new
/// parameters (ORP, ion generators, saturation index) and facility subtypes (swim-up
/// bars, spray grounds) keep appearing per state, and the whole point of this model is
/// that a new state is a data-entry exercise, not a schema change.
model ChemistryThreshold {
  id                  String            @id @default(cuid())
  complianceRulesetId String
  complianceRuleset   ComplianceRuleset @relation(fields: [complianceRulesetId], references: [id], onDelete: Cascade)

  parameter           String
  disinfectionMethod  DisinfectionMethod @default(NOT_APPLICABLE)
  /// e.g. "POOL", "SPA", "WADING_POOL", "SPRAY_GROUND", "SWIM_UP_BAR". Null = applies to
  /// all body types. Not the app's BodyOfWaterType enum on purpose -- see notes doc.
  bodyOfWaterCategory String?
  indoorOutdoor       String?
  /// Free-text condition this row is scoped to (e.g. "if CYA used", "with supplemental
  /// oxidizer"). Descriptive, not an evaluated expression -- see notes doc's "What's
  /// deliberately NOT built" section. Null = unconditional.
  appliesWhen         String?

  minValue  Decimal? @db.Decimal(10, 3)
  idealMin  Decimal? @db.Decimal(10, 3)
  idealMax  Decimal? @db.Decimal(10, 3)
  maxValue  Decimal? @db.Decimal(10, 3)
  /// A separate, optional tier that triggers closure risk specifically -- distinct from
  /// the routine min/max above (Nevada's pH hazard band 6.5-8.0 vs. its 7.2-7.8 target).
  /// Most states collected so far only have one tier; hazardMin/Max stay null there.
  hazardMin Decimal? @db.Decimal(10, 3)
  hazardMax Decimal? @db.Decimal(10, 3)
  unit      String?

  /// Cross-field/cross-method checks that aren't a flat range against this parameter
  /// alone (Alabama's CYA-conditional FC, Alaska's FAC > 0.5xTAC, Arkansas's Combined =
  /// Total - Free, Colorado's ion generators requiring a 0.4ppm chlorine residual).
  /// Stored faithfully as the regulation states it; not auto-evaluated this pass.
  relationalRule String? @db.Text

  /// Curve/table-based lookup in place of a flat threshold (Alaska's Table E, Colorado's
  /// Graph #1 -- a second reading redefines this one's acceptable range via a lookup,
  /// not a branch). curveDataPoints stays null until real tabulated values are sourced --
  /// never fabricated.
  isCurveBased     Boolean @default(false)
  curveDescription String? @db.Text
  curveDataPoints  Json?

  /// "confirmed" | "assumption" | "conflict" | "gap"
  sourceConfidence String?
  notes            String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([complianceRulesetId])
}

/// One row per testing cadence. intervalMinutes is a single canonical field covering both
/// sub-day (Colorado's 2-hour spa bundle) and supra-day (Nevada's 30-day CYA cycle)
/// frequencies.
model FrequencyRule {
  id                  String            @id @default(cuid())
  complianceRulesetId String
  complianceRuleset   ComplianceRuleset @relation(fields: [complianceRulesetId], references: [id], onDelete: Cascade)

  /// Same free-text convention as ChemistryThreshold.parameter, or "ALL" for a bundled
  /// reading (Colorado's spa disinfectant+pH+temperature bundle).
  parameter           String
  bodyOfWaterCategory String?
  /// A property attribute (not a pool type) that changes frequency -- e.g.
  /// "common_interest_development_under_25_units" (California's small-HOA exception).
  facilityAttribute   String?

  cadence            String?
  intervalMinutes    Int?
  /// California's combined-chlorine cadence is "whatever frequency maintains
  /// compliance," not a stated number -- cadence/intervalMinutes hold the closest
  /// stated approximation (if any); this flag says don't treat that as a hard interval.
  isPerformanceBased Boolean @default(false)
  /// Free-text condition this cadence is scoped to -- e.g. "fed continuously via
  /// stabilized chlorine" vs. "manually dosed" (New Mexico's CYA cadence depends on
  /// delivery method, not just whether the chemical is used at all). Null = unconditional.
  /// Same descriptive-not-evaluated convention as ChemistryThreshold.appliesWhen.
  appliesWhen        String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([complianceRulesetId])
}

/// Closures/reopening triggers that aren't a flat threshold breach -- incidents,
/// equipment performance, lab results, repeated-failure rules, chemical-triggered
/// testing obligations. See COMPLIANCE_RULESET_NOTES.md for the closureKind vocabulary.
model EventProtocol {
  id                  String            @id @default(cuid())
  complianceRulesetId String
  complianceRuleset   ComplianceRuleset @relation(fields: [complianceRulesetId], references: [id], onDelete: Cascade)

  /// Free-text, same data-entry-extensible reasoning as ChemistryThreshold.parameter --
  /// e.g. "FECAL_SOLID", "PATHOGEN_LAB_RESULT", "UV_DOSAGE_BELOW_MINIMUM", "CYA_IN_USE".
  triggerType  String
  triggerLabel String

  /// "FIXED_DURATION" | "UNTIL_RETEST_PASSES" | "INDETERMINATE_LAB_RETEST" |
  /// "N_CONSECUTIVE_FAILURES" | "DESCEND_BELOW_CEILING" | "EQUIPMENT_PERFORMANCE" |
  /// "CHEMISTRY_HAZARD_THRESHOLD" | "CHEMICAL_TESTING_OBLIGATION"
  closureKind String

  minimumDurationMinutes      Int?
  consecutiveFailuresRequired Int?
  /// Free-text condition this protocol variant is scoped to -- e.g. "if CYA present",
  /// "brominated facility", "blood". Lets a state have multiple EventProtocol rows for
  /// the same triggerType (New York's CYA-present row doubles the standard row's
  /// treatment time; California's CYA-present row is an entirely separate target).
  /// Null = the unconditional/baseline variant. Same convention as
  /// ChemistryThreshold.appliesWhen -- descriptive, not evaluated.
  appliesWhen                 String?
  /// Concentration x time inactivation target, when the source states one explicitly
  /// (New York's CT=15,300 for Crypto) -- lets multiple stated concentration/time pairs
  /// be cross-checked against the same number rather than only storing one hardcoded
  /// pair in reopeningCondition's prose. Null where a state doesn't state a CT value.
  ctValue                     Decimal? @db.Decimal(12, 2)
  ctValueUnit                 String?
  /// True when this protocol requires closing every body of water sharing the same
  /// filtration system, not just the specifically affected one (New York, California).
  cascadesToSharedFiltration  Boolean  @default(false)
  /// Described precisely enough to eventually encode (target chemical, direction,
  /// value, hold time) but kept as text this pass -- e.g. "Free chlorine >= 2.0 ppm AND
  /// pH <= 7.5, maintained 30 minutes", or Florida's descend-below-ceiling mirror case:
  /// "Free chlorine <= 10.0 mg/L".
  reopeningCondition          String   @db.Text
  remediationSteps            String?  @db.Text

  /// Chemical-triggered obligations (Florida: CYA/quat-ammonium/ozone/copper need a
  /// dedicated test kit; silver needs a full lab analysis every six months).
  requiresSeparateTestKit Boolean @default(false)
  labAnalysisFrequency    String?

  /// A real citation pointing elsewhere (Florida's fecal protocol defers to an external
  /// CDC document) -- distinct from a `gap` ComplianceNote, which is missing information.
  externalReferenceLabel String?
  externalReferenceUrl   String?

  /// Fee tied to this closure protocol, if any (Nevada's $909 SNHD reopening fee).
  feeAmount Decimal? @db.Decimal(10, 2)
  feeNote   String?

  sourceConfidence String?
  notes            String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([complianceRulesetId])
}

/// Structured record of every flagged gap/conflict/assumption from the source data --
/// exists so "do not silently resolve or guess at any flagged item" is enforced by the
/// schema itself, not left to a comment that could be forgotten.
model ComplianceNote {
  id                  String            @id @default(cuid())
  complianceRulesetId String
  complianceRuleset   ComplianceRuleset @relation(fields: [complianceRulesetId], references: [id], onDelete: Cascade)

  kind    String
  summary String  @db.Text
  detail  String? @db.Text

  createdAt DateTime @default(now())

  @@index([complianceRulesetId])
}

model ManagementCompany {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  phone String?
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Supabase Auth user id (`auth.users.id`) — set after user is created in Supabase
  authUserId String? @unique @db.Uuid

  email           String   @unique
  name            String?
  role            UserRole @default(TECHNICIAN)
  phone           String?
  active          Boolean  @default(true)
  /// Platform-level oversight access across ALL organizations — separate from the per-org `role`. Never settable via any UI; set manually by the platform owner.
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignedVisits                 ServiceVisit[]          @relation("VisitTechnician")
  assignedRoutes                 RecurringRoute[]        @relation("RouteTechnician")
  sentAlerts                     CustomerAlert[]
  adHocStops                     AdHocStop[]             @relation("AdHocStopTechnician")
  createdAdHocStops              AdHocStop[]             @relation("AdHocStopCreatedBy")
  recordedContaminationIncidents ContaminationIncident[]
  payRatesAsTechnician           TechnicianPayRate[]     @relation("TechnicianPayRateTechnician")
  payRatesCreated                TechnicianPayRate[]     @relation("TechnicianPayRateCreatedBy")
  payrollSettingsUpdates         OrgPayrollSettings[]
  phoneAgentSettingsUpdates      OrgPhoneAgentSettings[]

  @@index([organizationId])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String
  billingRef String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  properties    Property[]
  documents     CustomerDocument[]
  customerUsers CustomerUser[]
  alerts        CustomerAlert[]

  @@index([organizationId])
}

/// A customer-portal login (separate from staff `User`) — a customer's own contact who can
/// sign in at /portal to see their scheduled visits, reports, photos, documents, and alerts.
model CustomerUser {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Supabase Auth user id — set after the login is created in Supabase
  authUserId String? @unique @db.Uuid
  email      String  @unique
  name       String?
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

/// A one-way admin -> customer message, shown in the customer's portal and emailed.
model CustomerAlert {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  subject String
  message String

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([createdByUserId])
}

/// Uploaded files (inspection reports, contracts, etc.) shown on a customer's Overview tab.
/// Binary content lives in Supabase Storage; this row is just the pointer + metadata.
model CustomerDocument {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label       String
  storagePath String
  contentType String?
  fileSize    Int?

  createdAt DateTime @default(now())

  @@index([customerId])
}

model Property {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  name                 String
  /// Drives which on-site service form/compliance rules apply — single source of truth,
  /// not an account- or login-level setting.
  propertyType         PropertyType       @default(COMMERCIAL)
  managerName          String?
  managerBusinessPhone String?
  managerMobilePhone   String?
  managerPhone         String?
  managerEmail         String?
  /// On-site maintenance contact — separate from the property manager above.
  maintenanceName      String?
  maintenanceCellPhone String?
  maintenanceEmail     String?
  /// Residential-only: replaces Manager/Maintenance above for propertyType RESIDENTIAL.
  ownerName            String?
  ownerMobilePhone     String?
  ownerHomePhone       String?
  ownerEmail           String?
  /// Residential-only: directions for reaching the pool (gate code, parking, side yard, etc.)
  accessNotes          String?
  /// Residential-only: whether a dog is on the property, for technician awareness/safety.
  hasDog               Boolean            @default(false)
  managementCompanyId  String?
  managementCompany    ManagementCompany? @relation(fields: [managementCompanyId], references: [id], onDelete: SetNull)
  addressLine1         String?
  addressLine2         String?
  city                 String?
  region               String?
  postalCode           String?
  country              String?            @default("US")
  latitude             Decimal?           @db.Decimal(10, 7)
  longitude            Decimal?           @db.Decimal(10, 7)
  geofenceMeters       Int?
  notes                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bodiesOfWater          BodyOfWater[]
  visits                 ServiceVisit[]
  recurringStops         RecurringStop[]
  adHocStops             AdHocStop[]
  contaminationIncidents ContaminationIncident[]

  @@index([organizationId])
  @@index([customerId])
  @@index([managementCompanyId])
}

model BodyOfWater {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name             String
  type             BodyOfWaterType @default(POOL)
  volumeGallons    Decimal?        @db.Decimal(12, 2)
  /// SNHD-posted maximum bather load for this body of water
  maximumOccupancy Int?
  notes            String?

  /// SNHD log footer: minimum required recirculation flow (GPM)
  minimumRequiredFlowGpm Decimal? @db.Decimal(10, 2)
  /// SNHD log footer: maximum filter flow (GPM)
  maximumFilterFlowGpm   Decimal? @db.Decimal(10, 2)

  /// Residential-only, lightweight — reuses the FilterMedia enum but is deliberately
  /// separate from Equipment.filterMedia (that flow is a heavyweight form built for
  /// commercial's detailed compliance needs; this is one dropdown at customer creation).
  filterType                         FilterMedia?
  /// Only meaningful when filterType is CARTRIDGE.
  cartridgeCleaningIncluded          Boolean?
  cartridgeCleaningFrequencyPerMonth Int?

  /// Residential-only per-reading requirement toggles, set at customer creation/edit.
  /// Default true (full tracking) — commercial visits don't read these; they now derive
  /// their required-reading list from the org's linked ComplianceRuleset instead (see
  /// lib/compliance.ts's activeReadingFields), scoped further by this body's own
  /// disinfectionMethod below.
  requiresFC         Boolean @default(true)
  requiresPH         Boolean @default(true)
  requiresAlkalinity Boolean @default(true)
  requiresCYA        Boolean @default(true)

  /// Commercial only. Which disinfectant this specific body of water actually uses --
  /// most states' regulations give chlorine and bromine as alternatives (never both at
  /// once for the same body of water), and the app has no other way to know which one a
  /// technician should be logging a reading for. Defaults to CHLORINE (the common case,
  /// and what every commercial body already implicitly used before this field existed).
  disinfectionMethod DisinfectionMethod @default(CHLORINE)

  /// Public, unguessable slug used for this body of water's QR code / inspector log page
  publicSlug String @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment              Equipment[]
  serviceWeekdays        BodyOfWaterServiceWeekday[]
  visits                 ServiceVisit[]
  recurringStops         RecurringStop[]
  contaminationIncidents ContaminationIncident[]
  /// Other bodies of water closed as part of an incident cascade because they share this
  /// body's filtration system, without being the body where the incident was discovered.
  cascadedIncidents      ContaminationIncident[]     @relation("CascadedFiltrationClosure")
  payRates               TechnicianPayRate[]         @relation("TechnicianPayRateBody")
  bundledIntoPayRates    TechnicianPayRate[]         @relation("TechnicianPayRateBundledInto")
  volumeCalculation      VolumeCalculation?

  @@index([propertyId])
}

enum VolumeShape {
  RECTANGLE
  CIRCLE
  OVAL
  KIDNEY_FREEFORM
  MULTI_DEPTH
}

/// How a body of water's volumeGallons was derived, so a technician can come back and
/// correct one dimension instead of re-measuring the whole pool from scratch.
/// BodyOfWater.volumeGallons stays the single source of truth everything else (dosing,
/// compliance) reads -- this table is just the derivation, kept in sync by
/// saveVolumeCalculation, not read by anything else.
model VolumeCalculation {
  id            String      @id @default(cuid())
  bodyOfWaterId String      @unique
  bodyOfWater   BodyOfWater @relation(fields: [bodyOfWaterId], references: [id], onDelete: Cascade)

  shape VolumeShape

  /// RECTANGLE, OVAL: both required. CIRCLE: neither used (see radiusFt).
  lengthFt Decimal? @db.Decimal(8, 2)
  widthFt  Decimal? @db.Decimal(8, 2)
  /// CIRCLE only.
  radiusFt Decimal? @db.Decimal(8, 2)

  /// RECTANGLE/CIRCLE/OVAL/KIDNEY_FREEFORM only -- averaged for a sloped-floor pool.
  /// MULTI_DEPTH does not use these; see its own per-section depths below.
  shallowDepthFt Decimal? @db.Decimal(6, 2)
  deepDepthFt    Decimal? @db.Decimal(6, 2)

  /// KIDNEY_FREEFORM only -- the two width measurements the (A+B)*W approximation needs.
  freeformMeasurementA Decimal? @db.Decimal(8, 2)
  freeformMeasurementB Decimal? @db.Decimal(8, 2)

  /// MULTI_DEPTH only -- two independent rectangular sections, each with its own
  /// length/width/depth, summed after conversion rather than averaged into one shape.
  shallowSectionLengthFt Decimal? @db.Decimal(8, 2)
  shallowSectionWidthFt  Decimal? @db.Decimal(8, 2)
  shallowSectionDepthFt  Decimal? @db.Decimal(6, 2)
  deepSectionLengthFt    Decimal? @db.Decimal(8, 2)
  deepSectionWidthFt     Decimal? @db.Decimal(8, 2)
  deepSectionDepthFt     Decimal? @db.Decimal(6, 2)

  calculatedGallons Decimal  @db.Decimal(12, 2)
  lastCalculatedAt  DateTime
}

/// Open -> under remediation -> verified clean -> reopened. A real lifecycle, unlike a
/// routine ChemistryReading which is a single timestamped data point -- see
/// COMPLIANCE_RULESET_NOTES.md for why this is deliberately its own table rather than
/// extra columns on VisitWaterReading.
enum ContaminationIncidentStatus {
  OPEN
  UNDER_REMEDIATION
  VERIFIED_CLEAN
  REOPENED
}

/// A fecal/vomit/blood/other contamination event and its remediation, kept separate from
/// routine VisitWaterReading rows on purpose: different shape (lifecycle vs. single data
/// point), different rule category (an EventProtocol, not a ChemistryThreshold), and a
/// closure that can cascade across every body of water sharing one filtration system
/// (New York, California) -- none of which fits as nullable columns on a reading table.
/// Schema only this pass -- no UI/forms; see COMPLIANCE_RULESET_NOTES.md.
model ContaminationIncident {
  id                    String        @id @default(cuid())
  propertyId            String
  property              Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bodyOfWaterId         String
  /// The body of water where the incident was discovered/reported.
  bodyOfWater           BodyOfWater   @relation(fields: [bodyOfWaterId], references: [id], onDelete: Cascade)
  /// Every body of water actually closed by this incident, including the discovery body
  /// above -- populate this even for a single-body incident, since "which bodies were
  /// closed" should never require inferring from bodyOfWaterId alone once cascade rules
  /// (New York, California: close every venue sharing one filtration system) apply.
  affectedBodiesOfWater BodyOfWater[] @relation("CascadedFiltrationClosure")

  recordedByUserId String?
  recordedByUser   User?   @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  status ContaminationIncidentStatus @default(OPEN)

  /// Free-text, same data-entry-extensible convention as EventProtocol.triggerType --
  /// e.g. "FECAL_FORMED", "FECAL_DIARRHEAL", "VOMIT", "BLOOD", "OTHER".
  contaminationType String
  discoveredAt      DateTime
  batherCountAtTime Int?
  /// Whether cyanuric acid was present at the time, and its measured ppm if so --
  /// directly determines which state's CYA-present protocol variant applies (see
  /// EventProtocol.appliesWhen="if CYA present" rows).
  cyaPresentPpm     Decimal? @db.Decimal(10, 3)

  /// When the disinfectant first reached target concentration -- NOT necessarily when
  /// the CT/hold clock starts (see verifiedEvenDistributionAt below, Maryland's pattern).
  targetConcentrationReachedAt DateTime?
  /// Multi-point perimeter sampling (Maryland: every 15 ft) confirming the disinfectant
  /// is evenly distributed throughout the body of water -- some states' hold-time clock
  /// starts here, not at targetConcentrationReachedAt.
  verifiedEvenDistributionAt   DateTime?
  /// Georgia's explicit definition: Total Contact Time ends when the disinfectant
  /// concentration begins being reduced for reopening, not at reopenedAt itself.
  contactTimeEndedAt           DateTime?
  reopenedAt                   DateTime?

  remediationSteps String? @db.Text
  notes            String? @db.Text

  monitoringReadings IncidentMonitoringReading[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([bodyOfWaterId])
  @@index([status])
  @@index([recordedByUserId])
}

/// One row per checkpoint in an incident's monitoring grid -- California requires 3
/// (discovery, post-disinfection, reopening), Georgia requires 6 (start, 4 evenly-spaced
/// intervals, end). checkpointLabel stays free text for the same reason
/// ChemistryThreshold.parameter does: the grid shape varies by state.
model IncidentMonitoringReading {
  id                      String                @id @default(cuid())
  contaminationIncidentId String
  contaminationIncident   ContaminationIncident @relation(fields: [contaminationIncidentId], references: [id], onDelete: Cascade)

  /// e.g. "DISCOVERY", "POST_DISINFECTION", "REOPENING" (California's 3) or "START",
  /// "INTERVAL_1".."INTERVAL_4", "END" (Georgia's 6).
  checkpointLabel      String
  sequence             Int?
  recordedAt           DateTime
  freeChlorinePpm      Decimal? @db.Decimal(10, 3)
  totalChlorinePpm     Decimal? @db.Decimal(10, 3)
  ph                   Decimal? @db.Decimal(10, 3)
  temperature          Decimal? @db.Decimal(10, 3)
  /// Maryland's every-15-ft perimeter check confirming even distribution at this
  /// checkpoint specifically, distinct from ContaminationIncident.verifiedEvenDistributionAt
  /// (the single moment the overall hold clock started).
  distributionVerified Boolean  @default(false)
  notes                String?  @db.Text

  createdAt DateTime @default(now())

  @@index([contaminationIncidentId])
}

/// Which weekdays this body is serviced (1=Mon … 7=Sun). Enforce 1–7 distinct rows in application layer.
model BodyOfWaterServiceWeekday {
  id            String      @id @default(cuid())
  bodyOfWaterId String
  bodyOfWater   BodyOfWater @relation(fields: [bodyOfWaterId], references: [id], onDelete: Cascade)

  /// ISO 8601 weekday: 1 = Monday through 7 = Sunday
  weekday   Int
  createdAt DateTime @default(now())

  @@unique([bodyOfWaterId, weekday])
  @@index([bodyOfWaterId])
}

model Equipment {
  id            String      @id @default(cuid())
  bodyOfWaterId String
  bodyOfWater   BodyOfWater @relation(fields: [bodyOfWaterId], references: [id], onDelete: Cascade)

  kind           EquipmentKind @default(OTHER)
  make           String?
  model          String?
  serialNumber   String?
  /// For main drain covers, skimmer covers, and valves
  numberOfPorts  Int?
  /// Pipe sizing, e.g. "2 in"
  pipeSize       String?
  /// Date this item was last changed, serviced, or fixed
  lastServicedAt DateTime?
