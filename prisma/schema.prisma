/// Pre-signup marketing waitlist — deliberately not org-scoped (there's no
/// Organization yet at this point). Standalone table, no relations.
model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Dosing calculator -- built from real Taylor Technologies pool-chemistry manual tables,
// not unsourced approximations (a prior version of this feature was removed for exactly
// that reason). ALKALINITY_DOWN and PH_DOWN are each their own ChemicalType (not just a
// "direction" flag on ALKALINITY_UP/PH_UP) because Taylor's tables give each a genuinely
// different product choice (muriatic acid vs. dry acid) with its own dosing constant.
//
// pH is fundamentally different from every other chemical here: there is no ppm-delta
// formula for it at all, only a titration a technician actually performs (Taylor's Base/
// Acid Demand test). isDemandBased marks the 3 pH catalog rows so the calculator knows
// their dosingConstant is per-drop, not per-ppm -- see computePhDose in
// lib/dosing-calculator.ts, which is deliberately NOT part of the automatic
// computeDosingRecommendations pass the other chemicals go through.
//
// Bromine has no ChemicalType at all and never will for this feature -- Taylor's own
// materials explicitly say to follow the sanitizer manufacturer's label for bromine
// dosing, not a chart. The Dosing Card shows an advisory note for bromine, computed from
// nothing in this schema.
enum ChemicalType {
  FREE_CHLORINE
  PH_UP
  PH_DOWN
  ALKALINITY_UP
  ALKALINITY_DOWN
  CYA
  CALCIUM_HARDNESS
  SALT
}

enum ChemicalProductForm {
  LIQUID
  GRANULAR
}

enum DosingUnit {
  OZ
  FL_OZ
}

/// Global, system-seeded chemical product reference catalog -- NOT org-scoped. Orgs never
/// build this list from scratch; they enable/price/primary-pick rows via
/// OrgChemicalProductSetting. See prisma/seed-chemical-product-catalog.ts for the sourced
/// constants and lib/dosing-calculator.ts for how dosingConstant is used.
model ChemicalProductCatalog {
  id String @id @default(cuid())

  name         String
  chemicalType ChemicalType
  /// Percent active ingredient, e.g. 65.0, 31.45. Null for the 100%-active products
  /// (chlorine gas, sodium thiosulfate, soda ash, baking soda) where it'd be redundant.
  activePercent Decimal? @db.Decimal(6, 2)
  form          ChemicalProductForm
  dosingUnit    DosingUnit

  /// Amount of dosingUnit per 1 ppm of target-current delta, per 10,000 gallons --
  /// EXCEPT when isDemandBased is true, where this is per 1 drop of Taylor Base/Acid
  /// Demand Reagent, per 10,000 gallons, instead. Sourced directly from Taylor
  /// Technologies' printed treatment tables (Tables A, C, D, E, F, G, H, I, J, K, L),
  /// cross-validated against the tables' own additive-column property before being
  /// transcribed here -- see the seed script for the per-table citation.
  dosingConstant Decimal @db.Decimal(10, 4)
  /// True only for the 3 pH products (PH_UP soda ash, PH_DOWN muriatic acid, PH_DOWN dry
  /// acid) -- see this model's own doc comment and computePhDose.
  isDemandBased  Boolean @default(false)

  isSystemDefault Boolean @default(true)
  displayOrder    Int     @default(0)

  /// System-default Safety Data Sheet -- a link to the document as published on the
  /// manufacturer/distributor's own site, NOT a copy we downloaded and re-host, so orgs
  /// always see the current version. Sourced and individually verified (real PDF, correct
  /// chemical/concentration match) rather than industry-generic filler -- null where no
  /// verified source was found (e.g. Cal-Hypo at 45%/60%/75%), in which case an org must
  /// upload their own before anything shows for that product (see
  /// OrgChemicalProductSetting's sds* fields). Never substitute a mismatched-concentration
  /// document here -- no default is safer than a wrong one for a hazard document.
  sdsDocumentUrl String?
  /// Short citation shown next to the linked document, e.g. "HASA Inc." or "Olin Chlor
  /// Alkali" -- who actually published it, for transparency.
  sdsSourceLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgSettings OrgChemicalProductSetting[]

  @@unique([name])
  @@index([chemicalType])
}

/// Org-scoped settings for a single ChemicalProductCatalog row -- one per org per catalog
/// product the org has actually touched (enabled, priced, or set primary). A row the org
/// never interacts with simply doesn't exist here.
model OrgChemicalProductSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  catalogProductId String
  catalogProduct   ChemicalProductCatalog @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)

  /// "We use this" -- defaults false until the org confirms; only isEnabled: true rows are
  /// eligible for the dosing calculator at all.
  isEnabled Boolean  @default(false)
  /// Org's own cost, same Decimal(10,4) convention as ChemicalProduct.costPerUnit -- kept
  /// as a plain field rather than linked to that org's separate free-text billing catalog,
  /// since the two catalogs serve different purposes (this one drives dose math, that one
  /// drives invoicing) and forcing a link would couple them for no functional benefit.
  price     Decimal? @db.Decimal(10, 4)

  /// Exactly one isPrimary: true row per org per chemicalType among enabled rows -- the
  /// dosing calculator uses this one automatically, no per-visit tech product choice.
  /// Enforced at the service layer (app/dashboard/chemicals/actions.ts), not a DB
  /// constraint, same convention as the prior version of this feature.
  isPrimary Boolean @default(false)

  /// Optional link to the org's own free-text billing catalog (ChemicalProduct), so a
  /// computed recommendation can be applied as a logged VisitChemicalDose without the
  /// technician re-entering the amount in a second place. SetNull on delete -- losing the
  /// linked billing product shouldn't break this dosing setting, just fall back to the
  /// manual-entry path (see lib/dosing-units.ts's convertToBillingUnit, which is what
  /// decides whether a given link's unit is even auto-convertible from the dosing amount).
  linkedBillingProductId String?
  linkedBillingProduct   ChemicalProduct? @relation(fields: [linkedBillingProductId], references: [id], onDelete: SetNull)

  /// Org's own uploaded Safety Data Sheet, overriding the catalog product's system-default
  /// sdsDocumentUrl -- e.g. their actual supplier's formulation differs from the generic
  /// default. Stored the same way CustomerDocument stores files (see
  /// lib/customer-documents.ts): a private Supabase Storage object, not a public URL.
  /// Resolution order (see lib/sds-documents.ts): this upload, if present, else the
  /// catalog's sdsDocumentUrl, else nothing to show.
  sdsStoragePath  String?
  sdsFileName     String?
  sdsContentType  String?
  sdsFileSize     Int?
  sdsUploadedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, catalogProductId])
  @@index([organizationId])
  @@index([catalogProductId])
  @@index([linkedBillingProductId])
}

/// Org-level override of a chemical's dosing target, layered on top of the state's own
/// ComplianceRuleset numbers (see lib/compliance.ts's activeChemistryThresholds/
/// chlorineFamilyThreshold, reused directly by lib/dosing-calculator.ts's target
/// resolution -- this schema does not duplicate that data). Only meaningful for chemicals
/// with real compliance-relevant bounds: FREE_CHLORINE, PH, ALKALINITY, CYA, and
/// CALCIUM_HARDNESS (some states, e.g. Colorado, do regulate it -- unlike Salt, it is NOT
/// blanket "no compliance basis"). SALT has no ComplianceRuleset backing anywhere in the
/// seeded data -- for it, this is the ONLY way to get a target, always a single point
/// value, never a min/max range.
model OrgComplianceTarget {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// USPS 2-letter code, matching Organization.state / ComplianceRuleset.state scope. Null
  /// for SALT, which has no state basis to key off of at all.
  state        String?
  /// PH_DOWN and ALKALINITY_DOWN never get their own row -- pH and Alkalinity are each one
  /// target range regardless of correction direction; PH_UP/ALKALINITY_UP are the
  /// canonical rows. Enforced in app/dashboard/chemicals/actions.ts, not the DB.
  chemicalType ChemicalType

  orgTargetMin   Decimal? @db.Decimal(10, 3)
  orgTargetMax   Decimal? @db.Decimal(10, 3)
  /// Single-point target (Salt's generator-specified ppm), used instead of a min/max range
  /// when the chemical's target is naturally one number, not a band.
  orgTargetValue Decimal? @db.Decimal(10, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, chemicalType])
  @@index([organizationId])
}

/// How an org's pay period resets -- see OrgPayrollSettings. tech-earnings-tracker-spec.md
/// Section 7: this app is white-labeled for other pool service companies, and pay cycles
/// vary by org, so period-boundary math (lib/technician-pay.ts) always branches on this
/// rather than assuming any one org's cycle.
enum PayPeriodType {
  WEEKLY
  BIWEEKLY
  SEMI_MONTHLY
  MONTHLY
}

/// How an org pays its technicians. PER_PROPERTY (flat rate per technician x body of
/// water, via TechnicianPayRate) is the only value actually wired up in v1 -- see
/// tech-earnings-tracker-spec.md Section 8. Deliberately not adding HOURLY/
/// FLAT_PER_VISIT/PROPERTY_TYPE_TIERED members yet: those need their own tables and
/// calculation-service branches (hourly in particular runs on elapsed time, not visits
/// completed) that don't exist yet, so an unused enum value with no backing logic would be
/// misleading rather than useful groundwork.
enum PayStructureType {
  PER_PROPERTY
}

/// One row per org -- org-configurable pay-period and pay-structure settings for the
/// technician earnings tracker (tech-earnings-tracker-spec.md Sections 7-8). Period-
/// boundary and rate-lookup logic (lib/technician-pay.ts) always branches on this row
/// rather than assuming any one org's cycle -- Lindley's own semi-monthly/15th split is
/// just this org's seeded setting (prisma/seed.ts), not global application logic.
model OrgPayrollSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  payPeriodType    PayPeriodType    @default(SEMI_MONTHLY)
  /// Only PER_PROPERTY is wired up in v1 -- see the PayStructureType doc comment.
  payStructureType PayStructureType @default(PER_PROPERTY)

  /// Used when payPeriodType = WEEKLY. ISO weekday (Mon=1..Sun=7), matching
  /// RecurringRoute.dayOfWeek's own convention -- see lib/visit-generation.ts.
  weeklyStartDayOfWeek    Int?
  /// Used when payPeriodType = BIWEEKLY -- first day of a known past pay period, the fixed
  /// reference point every subsequent 14-day window is calculated from (biweekly isn't
  /// calendar-aligned like semi-monthly, so a day-of-month isn't enough -- it needs an
  /// anchor date).
  biweeklyAnchorStartDate DateTime? @db.Date
  /// Used when payPeriodType = SEMI_MONTHLY. Standard is 1st-15th / 16th-end of month;
  /// this exists in case an org splits differently, though 15 covers the common case.
  semiMonthlySplitDay     Int?      @default(15)
  /// Used when payPeriodType = MONTHLY -- day of month the period resets.
  monthlyPayDay           Int?

  updatedByUserId String?
  updatedByUser   User?   @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedByUserId])
}

/// Per-(technician, body of water) flat pay rate -- what THIS tech is paid for completing
/// a service visit at THIS body of water, admin-set and admin-only visible. Powers the
/// technician's running "Estimated Earnings" total on TechnicianHome; the tech never sees
/// this table directly, only the aggregate total -- see lib/technician-pay.ts. Only the v1
/// PER_PROPERTY pay structure reads this table, and only through resolveRateForVisit()
/// there, never ad hoc -- see that function's doc comment for why.
///
/// History is kept rather than overwritten -- effectiveDate + isActive let a rate change
/// apply going forward without altering what a past, already-completed visit should have
/// paid. Earnings are always recomputed live from current ServiceVisit state (never an
/// incremental counter), so a visit reverted/rescheduled after completion is reflected
/// automatically with no separate reversal hook needed.
model TechnicianPayRate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  technicianId String
  technician   User   @relation("TechnicianPayRateTechnician", fields: [technicianId], references: [id], onDelete: Cascade)

  bodyOfWaterId String
  bodyOfWater   BodyOfWater @relation("TechnicianPayRateBody", fields: [bodyOfWaterId], references: [id], onDelete: Cascade)

  /// Flat $ paid to this tech for completing a service visit at this body of water. Can
  /// legitimately be 0 -- see isBundled below.
  rateAmount Decimal @db.Decimal(10, 2)

  /// True when this body of water's pay is folded into another body at the same property
  /// (the common case: a spa's pay is bundled into its paired pool's rate, so the spa
  /// itself pays $0 on its own). A rateAmount: 0 row with isBundled: true is a valid,
  /// intentional state -- never treated as a missing rate by the "Unrated visits" check.
  isBundled Boolean @default(false)

  /// Which body of water actually carries the combined rate, for admin clarity/audit only
  /// -- NOT used in earnings calculation (rateAmount already reflects the real number to
  /// add, even if 0). Purely so an admin looking at the rate table later understands WHY a
  /// row is $0 instead of wondering if it was missed.
  bundledIntoBodyOfWaterId String?
  bundledIntoBodyOfWater   BodyOfWater? @relation("TechnicianPayRateBundledInto", fields: [bundledIntoBodyOfWaterId], references: [id], onDelete: SetNull)

  isActive      Boolean  @default(true)
  /// Date this rate takes effect. A visit's earnings use the rate that was active as of
  /// the visit's OWN completion timestamp, not always the latest row.
  effectiveDate DateTime @db.Date

  createdByUserId String?
  createdByUser   User?   @relation("TechnicianPayRateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([technicianId, bodyOfWaterId, effectiveDate])
  @@index([bodyOfWaterId])
  @@index([bundledIntoBodyOfWaterId])
  @@index([createdByUserId])
}

/// AI Interactive Answering Agent -- opt-in add-on. Whether a call falls to the fallback
/// flow because nobody's there (after-hours) or because the primary line rang unanswered
/// during business hours (overflow) -- both land in the same interactive-voicemail flow,
/// just with different greeting/callback-promise text (see below).
enum PhoneAgentRouteReason {
  AFTER_HOURS
  BUSY_OVERFLOW
}

/// Lifecycle of a single call's own record, independent of ticketStatus below (which
/// tracks the ops-workflow state of the resulting ticket, not whether the call itself
/// completed). ABANDONED covers a caller hanging up mid-flow -- that call should still
/// show up in the dashboard, not vanish silently.
enum PhoneAgentCallStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PhoneAgentTicketStatus {
  NEW
  REVIEWED
  RESOLVED
}

enum PhoneAgentUrgency {
  ROUTINE
  SAME_DAY
  EMERGENCY
}

/// Deliberately a small, developer-controlled enum, not a free string -- unlike
/// ChemistryThreshold.parameter (which stays free-text because state regulations keep
/// naming new ones), the set of phone-intake issue types is stable and benefits from
/// being constrained: better LLM classification accuracy, and a filterable dashboard.
enum PhoneAgentIssueType {
  EQUIPMENT_FAILURE
  CHEMICAL_WATER_QUALITY
  LEAK
  NO_SHOW_COMPLAINT
  BILLING
  OTHER
}

enum PhoneAgentPhoneTreeSelection {
  NEW_REQUEST
  EXISTING_CUSTOMER
  URGENT
  MESSAGE
}

/// Per-org configuration for the AI phone agent -- same 1:1-with-Organization shape as
/// OrgPayrollSettings (organizationId unique + reciprocal field + updatedByUser audit
/// pair), not a composite id.
model OrgPhoneAgentSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The Twilio number assigned to this org -- how an inbound call's `To` field resolves
  /// to the right org's settings in the voice webhook. Unique: one Twilio number routes
  /// to exactly one org.
  twilioPhoneNumber String? @unique
  /// The org's real business/owner line, dialed first before ever falling through to
  /// this agent.
  primaryPhoneNumber String?
  ringTimeoutSeconds Int     @default(20)

  /// Per-weekday "HH:MM-HH:MM" (24h) open/close string, keyed "mon".."sun"; a missing or
  /// null key means closed that day. Only used to decide AFTER_HOURS vs BUSY_OVERFLOW
  /// framing/copy at call time -- never gates whether the agent answers (it always does,
  /// on no-answer/busy/failed, regardless of configured hours).
  businessHours Json?

  /// First String[] columns in this schema -- every other "multiple recipients" case
  /// (e.g. sendCustomerAlertEmail's loop) derives its list from related rows, not a raw
  /// array column. Deliberate deviation for this rarely-edited settings form, not an
  /// oversight: a join table would be more consistent with the rest of the schema but is
  /// more ceremony than this MVP settings surface needs.
  escalationPhones String[]
  escalationEmails String[]

  serviceTerritoryDescription String? @db.Text

  /// Genuinely different messages -- "we're closed for the day" vs. "we're just away
  /// from the phone" -- never collapsed into one generic greeting.
  afterHoursGreeting          String? @db.Text
  busyOverflowGreeting        String? @db.Text
  afterHoursCallbackPromise   String? @db.Text
  busyOverflowCallbackPromise String? @db.Text

  allowedIssueTypes PhoneAgentIssueType[]

  /// Server-side caps, enforced in the voice webhook itself (never just a UI limit) --
  /// see PhoneAgentDailyUsage, which makes checking these cheap without scanning every
  /// PhoneAgentCall row.
  maxCallsPerDay          Int?
  maxMinutesPerDay        Int?
  maxCallDurationSeconds  Int?

  updatedByUserId String?
  updatedByUser   User?   @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per inbound call that falls through to the agent -- created early (as soon as
/// the primary-line Dial comes back no-answer/busy/failed) and updated across the
/// call-flow's subsequent webhook steps, not created fresh at the very end. This is what
/// lets a caller who hangs up mid-flow (before ever reaching <Record>) still leave a
/// visible ABANDONED row instead of vanishing with no trace.
model PhoneAgentCall {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Twilio's own call identifier -- stable across every webhook step for one call, and
  /// the idempotency key for PhoneAgentDailyUsage increments (Twilio retries a webhook on
  /// timeout/5xx; without this, a retry would double-count usage and double-send the
  /// notification email).
  twilioCallSid String @unique
  callerNumber  String
  startedAt     DateTime @default(now())

  routedAs   PhoneAgentRouteReason
  callStatus PhoneAgentCallStatus  @default(IN_PROGRESS)

  phoneTreeSelection PhoneAgentPhoneTreeSelection?

  recordingUrl String?
  /// Kept as two separate fields, never merged -- if the AI misreads something, there
  /// has to be a way to check it against what the caller actually said.
  rawTranscript String? @db.Text
  aiSummary     String? @db.Text

  callerName           String?
  callerCallbackNumber String?
  propertyAddress      String?
  issueType            PhoneAgentIssueType?
  urgency              PhoneAgentUrgency?
  requestedCallbackTime String? @db.Text

  ticketStatus PhoneAgentTicketStatus @default(NEW)

  durationSeconds Int?
  /// Decimal, matching every other cost field in this schema (feeAmount, pay-rate
  /// amounts, etc.) -- no cents-as-Int convention exists here, so this doesn't introduce
  /// one for future billing/metering use.
  estimatedCost   Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// Per-org, per-day aggregate -- lets the voice webhook cheaply check daily call/minute
/// caps (a single row lookup) instead of scanning every PhoneAgentCall row on every
/// incoming call.
model PhoneAgentDailyUsage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  callCount            Int @default(0)
  totalDurationSeconds Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, date])
}
