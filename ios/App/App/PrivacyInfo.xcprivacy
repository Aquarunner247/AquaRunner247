<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest for the AquaRunner 24/7 Pro iOS app.

  Required by Apple since spring 2024; an app submitted without one is rejected. It has to
  agree with two other things, and the three are easy to let drift apart:

    1. content/legal/privacy-policy.md, Section 4 ("Personal Information We Collect")
    2. the App Privacy answers in App Store Connect, which produce the public nutrition label

  Everything declared here is traceable to Section 4. Nothing is declared that the app does
  not actually collect — over-declaring shows up on the public label as data you take, which
  is its own kind of inaccuracy.

  NOT declared, deliberately:
    - Photo library. app/components/camera-capture.tsx:182 uses CameraSource.Camera only, so
      the library is never read. Info.plist has no NSPhotoLibraryUsageDescription for the same
      reason.
    - Audio. Inbound phone calls are recorded by Twilio server-side; the app never opens the
      microphone.
    - Payment / financial info. Stripe runs on the web and is not configured in production at
      all as of this writing; the app has no purchase flow.
    - Contacts, health, browsing or search history, advertising identifiers. None are touched.

  Required-reason APIs: the app target's own native code is two stock Capacitor templates
  (AppDelegate.swift, SceneDelegate.swift, 68 lines between them) and uses none of them.
  UserDefaults is declared because Capacitor's WebView layer stores app configuration there,
  which is reason CA92.1 — access to information from the same app. Capacitor 8 and its
  plugins ship their own manifests for anything they use beyond that.
-->
<plist version="1.0">
<dict>
	<!-- No advertising identifiers, no ad networks, no cross-app or cross-site measurement.
	     This is the same answer given in Privacy Policy Section 10 ("Sale and targeted
	     advertising status") and Section 21. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- The single position fix that records arrival at a stop. Privacy Policy Section 4,
		     Location row: the app reads location continuously while a route is open but only
		     the arrival fix is transmitted and stored. Departure from a stop is also derived
		     from those readings, on device, and leaves as a timestamp with no position, so it
		     adds nothing to this declaration. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Property and service addresses entered by the organization. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhysicalAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Proof-of-service photos taken during a visit, often geotagged and timestamped. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Account identity: the signed-in technician or administrator, plus the people an
		     organization enters as customers and property contacts. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhoneNumber</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Chemistry readings, dosages, checklists, inspection records and technician notes:
		     the work product the app exists to capture. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Error reports and server traces (Sentry, Dash0 — both named in the sub-processor
		     list). Declared as linked because an error payload carries the request URL, which
		     contains organization and visit identifiers that resolve to an account.

		     Two purposes, matching the "App performance -> Crash logs" row on the Play form,
		     which is filed as App functionality + Analytics. AppFunctionality is the primary one
		     — Apple's definition names "minimizing app crashes" outright — and Analytics belongs
		     because Sentry is also read in aggregate, for crash-free rates and error trends
		     rather than for fixing one report. Privacy Policy Section 6 authorizes both in the
		     same list: "troubleshoot issues" and "Analyze usage and performance, develop and
		     improve features".

		     Analytics added 2026-11-13. The row predates the Play filing and carried
		     AppFunctionality alone, so the two stores' public labels described the same Sentry
		     SDK differently. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- Performance traces and web vitals (Sentry tracing, Vercel Speed Insights).

		     Play files the matching rows — Diagnostics, and Other app performance data — as
		     Analytics ONLY, and that difference is deliberate rather than drift. Apple's
		     AppFunctionality definition explicitly covers "improving scalability and
		     performance", so a latency trace read to make a page faster is app functionality
		     here, while Play's App functionality purpose is about features available in the app.
		     Checked 2026-11-13 against both stores' definitions. Do not "reconcile" this by
		     dropping AppFunctionality — that would under-describe what the traces are for. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

		<!-- Page views, collected by @vercel/analytics, which app/layout.tsx loads in the ROOT
		     layout unconditionally — so it runs on every route, including inside the Capacitor
		     WebView. Privacy Policy Section 4, "Device and usage information" row: "interaction
		     with features".

		     Linked, for the same reason CrashData above is linked: what Vercel Analytics records
		     is the pathname, and this app's paths carry organization, body-of-water and visit
		     identifiers that resolve to an account. Vercel Analytics itself is cookieless and
		     sets no device identifier — that is why Privacy Policy Section 9 can say the site
		     runs no cookie consent banner — but "sets no identifier" is not the same question as
		     "is linked to the user".

		     Not tracking: first-party only, no ad network, no cross-app or cross-site
		     measurement.

		     Added 2026-11-12, after the Google Play Data safety form was read back from the
		     console and found to be missing the same row (App activity -> App interactions).
		     The two stores have to be told the same thing. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access info from the same app. Capacitor stores its own WebView and
				     plugin configuration in UserDefaults. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
