# =============================================================================
# SETUP: Copy this file to ".env" in the project root and replace placeholders.
#   cp .env.example .env
# Next.js loads only ".env" (and .env.local for overrides). Never commit real .env.
# =============================================================================

# --- REQUIRED: Database (Prisma) ---
# Supabase: Project Settings → Database → URI (pooled is OK; add ?pgbouncer=true if your host requires it)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
#
# Prisma 7 + pg: remote DATABASE_URL hosts (anything other than localhost/127.0.0.1 without sslmode=) use
# ssl: { rejectUnauthorized: false } by default to avoid "self-signed certificate in certificate chain" (P1011).
# Strict verification: DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Force relax: DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Local Postgres without TLS: use host localhost or 127.0.0.1 and omit sslmode= from the URL.

# Public site URL (used in links, callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- REQUIRED: Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Server-only (never expose to the browser) ---
# Service role: used by prisma/seed.ts to create dev Auth users — keep secret.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Password used when seeding demo logins (pool-admin@ / pool-office@ / pool-tech@ example.com)
SEED_DEV_PASSWORD="change-me-long-random"

# --- Supabase Auth URLs (Dashboard → Authentication → URL Configuration) ---
# Site URL:        http://localhost:3000
# Redirect URLs:  http://localhost:3000/auth/callback

# --- OPTIONAL: OpenStreetMap Nominatim (address search + geocoding for route maps) ---
# No API key required. Nominatim asks for a descriptive User-Agent (app name + contact).
# If unset, the app uses a built-in default string.
# https://operations.osmfoundation.org/policies/nominatim/
# NOMINATIM_USER_AGENT="YourCompany AquaRunner/1.0 (you@yourdomain.com)"

# --- REQUIRED for self-serve signup/billing: Stripe (Dashboard → Developers → API keys) ---
STRIPE_SECRET_KEY="sk_test_..."
# Dashboard → Developers → Webhooks → your endpoint → Signing secret (or `stripe listen` output locally)
STRIPE_WEBHOOK_SECRET="whsec_..."
# One recurring monthly Price per self-serve tier, created in your own Stripe dashboard.
# Enterprise has no price here -- it's contact-us/custom, set manually via /platform-admin.
STRIPE_PRICE_ID_SOLO="price_..."
STRIPE_PRICE_ID_STARTER="price_..."
STRIPE_PRICE_ID_PRO="price_..."
# AquaRunner Compliance (app/cpo) -- a separate product from the pool-service tiers above.
STRIPE_PRICE_ID_COMPLIANCE="price_..."

# --- REQUIRED for the cancellation safety-net export: Vercel Blob ---
# Auto-provisioned when you create a Blob store for this project (Vercel Dashboard →
# Storage → Create Database → Blob, or `vercel blob store add`) and connect it -- this is
# NOT something you set manually; `vercel env pull` after connecting will populate it.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- REQUIRED for the scrub cron (app/api/cron/scrub-canceled-orgs): Cron auth ---
# Any long random string. Vercel automatically sends it as `Authorization: Bearer <value>`
# when invoking this project's scheduled Cron Jobs (vercel.ts `crons`) -- the cron route
# checks it to reject any other caller.
CRON_SECRET="change-me-long-random"

# --- OPTIONAL: cancellation data-scrub dry-run toggle ---
# Defaults to dry-run (true) if unset -- the cron computes and records what it WOULD
# delete per canceled org but deletes nothing. Set to "false" only after reviewing a few
# real dry-run reports (OrganizationScrubRun.deletedCounts) and being confident the
# retain/delete split in lib/org-scrub.ts is correct. This is a deliberate, irreversible
# switch -- do not flip it casually.
# ORG_SCRUB_DRY_RUN="false"
