<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <!-- Themed icons, Android 13+. The launcher ignores these colours and tints the
         shape to the wallpaper palette, so this layer is the silhouette only: without
         it the icon simply opts out while every other app on the home screen adapts. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>