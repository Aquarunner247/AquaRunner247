# Copy to android/keystore.properties and fill in. That file is gitignored and must stay so.
#
# storeFile resolves relative to android/ (the Gradle root project), so a keystore kept in that
# same folder is just its filename. Keep the .jks out of git -- *.jks is ignored -- and back it
# up somewhere you will still have in five years.
storeFile=aquarunner-upload.jks
storePassword=
keyAlias=upload
keyPassword=
